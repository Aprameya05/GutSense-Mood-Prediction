# Groq API key (required — Groq Vision is the ground truth classifier)
# Get your key at https://console.groq.com/
GROQ_API_KEY=your-api-key-here

# HuggingFace image-classification model for the local EfficientNet challenger
# Default: nateraw/food (Food-101). Swap to an Indian food checkpoint as needed.
FOOD_MODEL_ID=nateraw/food
